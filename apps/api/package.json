{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch src/server.ts",
    "start": "node src/server.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@app/server": "workspace:*",
    "@fastify/type-provider-zod": "^1.0.0",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.8.5",
    "postgres": "^3.4.9",
    "ts-pattern": "^5.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.4.5",
    "@testcontainers/postgresql": "^11.14.0",
    "@types/node": "^25.6.2",
    "drizzle-kit": "^0.31.10",
    "testcontainers": "^11.14.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}
