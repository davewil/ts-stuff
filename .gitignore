# Ignore everything inside .claude/ EXCEPT settings.json (the shared
# statusline config). `.claude/*` rather than `.claude/` so git still
# recurses into the directory to evaluate the `!` re-include below —
# `!` can't override an excluded parent directory.
.claude/*
!.claude/settings.json

