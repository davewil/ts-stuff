{
  "name": "ts-stuff",
  "version": "0.0.0",
  "private": true,
  "description": "Regulated multi-tenant Node/TS backend test bed and the source of docs.davewil.dev",
  "homepage": "https://docs.davewil.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/davewil/ts-stuff.git"
  },
  "type": "module",
  "packageManager": "pnpm@11.0.8",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "test": "pnpm -r test",
    "test:watch": "pnpm -F api test:watch",
    "typecheck": "pnpm -r typecheck",
    "dev": "pnpm -F api dev",
    "start": "pnpm -F api start",
    "db:generate": "pnpm -F api db:generate",
    "db:migrate": "pnpm -F api db:migrate"
  }
}
